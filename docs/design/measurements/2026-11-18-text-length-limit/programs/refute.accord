fn all_tiny(xs: List<Text>) -> Bool
    ensures result
{
    all w in xs: length(w) + 1 <= 5
}

fn any_wrong(xs: List<Text>) -> Bool
    ensures result == (any w in xs: length(w) > 6)
{
    any w in xs: length(w) * 2 > 10
}

fn count_wrong(xs: List<Text>) -> i64
    ensures result == 0
{
    count w in xs: length(w) + 1 > 3
}

fn top_wrong(word: Text) -> i64
    ensures result <= 3
{
    length(word) + 1
}
