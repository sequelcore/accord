(set-option :produce-models true)
(set-logic ALL)
(declare-const p0 (Seq String))
(assert (<= (seq.len p0) 4294967295))
(assert (forall ((p1! Int)) (=> (and (<= 0 p1!) (< p1! (seq.len p0))) (let ((p1 (seq.nth p0 p1!))) (< (str.len p1) 100)))))
(declare-const r0 Bool)
(declare-const r1 Bool)
(assert (and (= r0 (forall ((p1! Int)) (=> (and (<= 0 p1!) (< p1! (seq.len p0))) (let ((p1 (seq.nth p0 p1!))) (<= (+ (str.len p1) 1) 100))))) (= r1 (forall ((p1! Int)) (=> (and (<= 0 p1!) (< p1! (seq.len p0))) (let ((p1 (seq.nth p0 p1!))) (<= (+ (str.len p1) 1) 101))))) (not (= r0 r1))))
(check-sat)
(get-value (p0 r0 r1))
(get-info :reason-unknown)
