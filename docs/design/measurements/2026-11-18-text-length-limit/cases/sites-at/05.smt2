(set-option :produce-models true)
(set-logic ALL)
(declare-const p0 (Seq String))
(assert (<= (seq.len p0) 4294967295))
(declare-const p1 Int)
(assert (and (<= (- 9223372036854775808) p1) (<= p1 9223372036854775807)))
(assert (and (>= p1 0) (< p1 (seq.len p0))))
(define-fun contract ((result Int)) Bool (= result (+ (str.len (seq.nth p0 p1)) 1)))
(declare-const r0 Int)
(declare-const r1 Int)
(assert (and (<= (- 9223372036854775808) r0) (<= r0 9223372036854775807)))
(assert (and (<= (- 9223372036854775808) r1) (<= r1 9223372036854775807)))
(assert (and (not false) (contract r0) (contract r1) (not (= r0 r1))))
(check-sat)
(get-value (p0 p1 r0 r1))
(get-info :reason-unknown)
