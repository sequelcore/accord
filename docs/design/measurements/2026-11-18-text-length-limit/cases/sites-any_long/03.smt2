(set-option :produce-models true)
(set-logic ALL)
(declare-const p0 (Seq String))
(assert (<= (seq.len p0) 4294967295))
(define-fun contract ((result Bool)) Bool (= result (exists ((p1! Int)) (and (and (<= 0 p1!) (< p1! (seq.len p0))) (let ((p1 (seq.nth p0 p1!))) (> (str.len p1) 5))))))
(declare-const r0 Bool)
(declare-const r1 Bool)
(assert (and (not false) (contract r0) (contract r1) (not (= r0 r1))))
(check-sat)
(get-value (p0 r0 r1))
(get-info :reason-unknown)
