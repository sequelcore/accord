(set-logic ALL)
(declare-datatype Standing ((Decide) (Gap) (Holds) (Opinion)))
(declare-const p (Seq Bool)) (declare-const t (Seq Bool)) (declare-const e (Seq Bool)) (declare-const x (Seq Standing))
; runStanding shape: equal lengths; loop-free body vs its ensures (exists of a non-covered path is the negation of all)
(assert (= (seq.len t) (seq.len p))) (assert (= (seq.len e) (seq.len p)))
(define-fun allc () Bool (forall ((k Int)) (=> (and (<= 0 k) (< k (seq.len p))) (or (seq.nth p k) (and (seq.nth t k) (seq.nth e k))))))
(define-fun somen () Bool (exists ((k Int)) (and (<= 0 k) (< k (seq.len p)) (not (seq.nth p k)) (not (and (seq.nth t k) (seq.nth e k))))))
(assert (not (= (not allc) somen)))
(check-sat)
