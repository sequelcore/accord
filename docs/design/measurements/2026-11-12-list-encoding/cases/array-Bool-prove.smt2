(set-logic ALL)
(declare-datatype Standing ((Decide) (Gap) (Holds) (Opinion)))
(declare-const s (Array Int Bool)) (declare-const n Int) (assert (>= n 0))
(assert (not (=> (forall ((k Int)) (=> (and (<= 0 k) (< k n)) (not (= (select s k) true))))
                 (not (exists ((k Int)) (and (<= 0 k) (< k n) (= (select s k) true)))))))
(check-sat)
