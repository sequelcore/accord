(set-logic ALL)
(declare-datatype Standing ((Decide) (Gap) (Holds) (Opinion)))
(declare-const p (Seq Bool))
(declare-const t (Seq Bool))
(declare-const e (Seq Bool))
(assert (= (seq.len t) (seq.len p)))
(assert (= (seq.len e) (seq.len p)))
(define-fun f0.requires ((a Bool) (b Bool) (c Bool)) Bool true)
(declare-fun f0 (Bool Bool Bool) Bool)
(define-fun f0.ensures ((a Bool) (b Bool) (c Bool) (result Bool)) Bool (= result (or a (and b c))))
(assert (forall ((a Bool) (b Bool) (c Bool)) (! (=> (f0.requires a b c) (f0.ensures a b c (f0 a b c))) :pattern ((f0 a b c)))))
(define-fun body () Bool (forall ((k Int)) (=> (and (<= 0 k) (< k (seq.len p))) (f0 (seq.nth p k) (seq.nth t k) (seq.nth e k)))))
(assert (not (= body (forall ((k Int)) (=> (and (<= 0 k) (< k (seq.len p))) (or (seq.nth p k) (and (seq.nth t k) (seq.nth e k))))))))
(check-sat)
