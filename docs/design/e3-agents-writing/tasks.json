   "id": "t05-grade",
   "prose": "Turn a test score into a letter grade. Callers guarantee the `score` is between 0 and 100 inclusive. Scores of 90 or more get A, 80 to 89 get B, 70 to 79 get C, and anything below 70 gets F.",
   "params": [
    "score"
   ],
   "types": [
    "Int"
   ],
   "result": "Grade",
   "accord": {
    "name": "grade",
    "decls": [
     "enum Grade { A, B, C, F }"
    ]
   },
   "ts": {
    "name": "grade",
    "params": [
     "score"
    ],
    "decls": [
     "export type Grade = \"a\" | \"b\" | \"c\" | \"f\";"
    ]
   },
   "examples": [
    {
     "args": {
      "score": 100
     },
     "expected": "A"
    },
    {
     "args": {
      "score": 90
     },
     "expected": "A"
    },
    {
