  {
   "id": "t07-proof-outcome",
   "prose": "Report how one proof run ended. The inputs say whether the run was `cancelled`, whether it `timed_out`, whether it `started` at all, whether its files were `regenerated`, the exit code of the check (`check_exit`) and how many obligations were `verified` (callers guarantee zero or more). A cancelled run is Cancelled, even if it also timed out. Otherwise a run that timed out is TimedOut. Otherwise a run that never started is NotStarted. Otherwise, if regeneration failed or the check exited with a nonzero code, it is Failed. Otherwise it is Passed when at least one obligation was verified, and Vacuous when none was.",
   "params": [
    "cancelled",
    "timed_out",
    "started",
    "regenerated",
    "check_exit",
    "verified"
   ],
   "types": [
    "Bool",
    "Bool",
    "Bool",
    "Bool",
    "Int",
    "Int"
   ],
   "result": "ProofOutcome",
   "accord": {
    "name": "proof_outcome",
    "decls": [
     "enum ProofOutcome { Passed, Failed, Vacuous, TimedOut, Cancelled, NotStarted }"
    ]
   },
   "ts": {
    "name": "proofOutcome",
    "params": [
     "cancelled",
     "timedOut",
     "started",
     "regenerated",
     "checkExit",
     "verified"
    ],
    "decls": [
     "export type ProofOutcome = \"passed\" | \"failed\" | \"vacuous\" | \"timed_out\" | \"cancelled\" | \"not_started\";"
    ]
   },
   "examples": [
    {
     "args": {
      "cancelled": false,
      "timed_out": false,
      "started": true,
      "regenerated": true,
      "check_exit": 0,
      "verified": 3
     },
     "expected": "Passed"
    },
    {
     "args": {
      "cancelled": false,
      "timed_out": false,
      "started": true,
      "regenerated": true,
      "check_exit": 0,
      "verified": 0
     },
     "expected": "Vacuous"
    },
    {
     "args": {
      "cancelled": true,
      "timed_out": true,
      "started": true,
      "regenerated": true,
      "check_exit": 0,
      "verified": 3
     },
     "expected": "Cancelled"
    },
    {
     "args": {
      "cancelled": false,
      "timed_out": true,
      "started": true,
      "regenerated": true,
      "check_exit": 0,
      "verified": 3
     },
     "expected": "TimedOut"
    },
    {
     "args": {
      "cancelled": false,
      "timed_out": false,
      "started": false,
      "regenerated": true,
      "check_exit": 0,
      "verified": 3
     },
     "expected": "NotStarted"
    },
    {
     "args": {
      "cancelled": false,
      "timed_out": false,
      "started": true,
      "regenerated": false,
      "check_exit": 0,
      "verified": 3
     },
     "expected": "Failed"
    },
    {
     "args": {
      "cancelled": false,
      "timed_out": false,
      "started": true,
      "regenerated": true,
      "check_exit": 1,
      "verified": 3
     },
     "expected": "Failed"
    },
    {
     "args": {
      "cancelled": false,
      "timed_out": true,
      "started": false,
      "regenerated": false,
      "check_exit": 2,
      "verified": 0
     },
     "expected": "TimedOut"
    },
    {
     "args": {
      "cancelled": true,
      "timed_out": false,
      "started": false,
      "regenerated": false,
      "check_exit": 1,
      "verified": 0
     },
     "expected": "Cancelled"
    }
   ]
  },
  {
   "id": "t08-mutant-finding",
   "prose": "Report what one mutant's proof outcome says about the contract it was proved under. A Failed proof means the contract rejected the mutant (Rejected). A Passed proof means the mutant survived (Survived). Any other outcome is Inconclusive.",
   "params": [
    "outcome"
   ],
   "types": [
    "ProofOutcome"
   ],
   "result": "MutantFinding",
   "accord": {
    "name": "mutant_finding",
    "decls": [
     "enum ProofOutcome { Passed, Failed, Vacuous, TimedOut, Cancelled, NotStarted }",
     "enum MutantFinding { Rejected, Survived, Inconclusive }"
    ]
   },
   "ts": {
    "name": "mutantFinding",
    "params": [
     "outcome"
    ],
    "decls": [
     "export type ProofOutcome = \"passed\" | \"failed\" | \"vacuous\" | \"timed_out\" | \"cancelled\" | \"not_started\";",
     "export type MutantFinding = \"rejected\" | \"survived\" | \"inconclusive\";"
    ]
   },
   "examples": [
    {
     "args": {
      "outcome": "Passed"
     },
     "expected": "Survived"
    },
    {
     "args": {
      "outcome": "Failed"
     },
     "expected": "Rejected"
    },
    {
     "args": {
      "outcome": "Vacuous"
     },
     "expected": "Inconclusive"
    },
    {
     "args": {
      "outcome": "TimedOut"
     },
     "expected": "Inconclusive"
    },
    {
     "args": {
      "outcome": "Cancelled"
     },
     "expected": "Inconclusive"
    },
    {
     "args": {
      "outcome": "NotStarted"
     },
     "expected": "Inconclusive"
    }
   ]
  },
  {
   "id": "t09-partial-decision",
   "prose": "Decide an authorization request when some policies could not be evaluated yet. The inputs say whether some forbid policy is already satisfied (`satisfied_forbid`), whether some permit policy is already satisfied (`satisfied_permit`), whether some permit policy is still unevaluated (`residual_permit`), and whether some forbid policy is still unevaluated (`residual_forbid`). Forbid wins: the answer is Deny when a forbid is satisfied, and also Deny when no permit is satisfied and none remains that could be. It is Allow when a permit is satisfied, no forbid is satisfied and no forbid remains. In every other case the decision is Unknown.",
   "params": [
    "satisfied_forbid",
    "satisfied_permit",
    "residual_permit",
    "residual_forbid"
   ],
   "types": [
    "Bool",
    "Bool",
    "Bool",
    "Bool"
   ],
   "result": "PartialDecision",
   "accord": {
    "name": "partial_decision",
    "decls": [
     "enum PartialDecision { Deny, Allow, Unknown }"
    ]
   },
   "ts": {
    "name": "partialDecision",
    "params": [
     "satisfiedForbid",
     "satisfiedPermit",
     "residualPermit",
     "residualForbid"
    ],
    "decls": [
     "export type PartialDecision = \"deny\" | \"allow\" | \"unknown\";"
    ]
   },
   "examples": [
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": false,
      "residual_permit": false,
      "residual_forbid": false
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": false,
      "residual_permit": false,
      "residual_forbid": true
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": false,
      "residual_permit": true,
      "residual_forbid": false
     },
     "expected": "Unknown"
    },
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": false,
      "residual_permit": true,
      "residual_forbid": true
     },
     "expected": "Unknown"
    },
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": true,
      "residual_permit": false,
      "residual_forbid": false
     },
     "expected": "Allow"
    },
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": true,
      "residual_permit": false,
      "residual_forbid": true
     },
     "expected": "Unknown"
    },
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": true,
      "residual_permit": true,
      "residual_forbid": false
     },
     "expected": "Allow"
    },
    {
     "args": {
      "satisfied_forbid": false,
      "satisfied_permit": true,
      "residual_permit": true,
      "residual_forbid": true
     },
     "expected": "Unknown"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": false,
      "residual_permit": false,
      "residual_forbid": false
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": false,
      "residual_permit": false,
      "residual_forbid": true
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": false,
      "residual_permit": true,
      "residual_forbid": false
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": false,
      "residual_permit": true,
      "residual_forbid": true
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": true,
      "residual_permit": false,
      "residual_forbid": false
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": true,
      "residual_permit": false,
      "residual_forbid": true
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": true,
      "residual_permit": true,
      "residual_forbid": false
     },
     "expected": "Deny"
    },
    {
     "args": {
      "satisfied_forbid": true,
      "satisfied_permit": true,
      "residual_permit": true,
      "residual_forbid": true
