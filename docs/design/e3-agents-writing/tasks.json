     },
     "expected": "B"
    },
    {
     "args": {
      "score": 80
     },
     "expected": "B"
    },
    {
     "args": {
      "score": 79
     },
     "expected": "C"
    },
    {
     "args": {
      "score": 70
     },
     "expected": "C"
