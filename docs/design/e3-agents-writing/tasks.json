  {
   "id": "t10-gate-verdict",
   "prose": "Decide what a verification gate does with one file's proof outcome. A Passed proof is Proved. A proof that is NotStarted, TimedOut or Cancelled goes to the operator (Operator). A Failed or Vacuous proof goes back to the agent (SendBack), unless its `failure` message is one the gate already sent back for this file, listed in `sent`: then the correction made no progress (NoProgress).",
   "params": [
    "outcome",
    "failure",
    "sent"
   ],
   "types": [
    "ProofOutcome",
    "Text",
    "List<Text>"
   ],
   "result": "GateVerdict",
   "accord": {
    "name": "gate_verdict",
    "decls": [
     "enum ProofOutcome { Passed, Failed, Vacuous, TimedOut, Cancelled, NotStarted }",
     "enum GateVerdict { Proved, SendBack, NoProgress, Operator }"
    ]
   },
   "ts": {
    "name": "gateVerdict",
    "params": [
     "outcome",
     "failure",
     "sent"
    ],
    "decls": [
     "export type ProofOutcome = \"passed\" | \"failed\" | \"vacuous\" | \"timed_out\" | \"cancelled\" | \"not_started\";",
     "export type GateVerdict = \"proved\" | \"send_back\" | \"no_progress\" | \"operator\";"
    ]
   },
   "examples": [
    {
     "args": {
      "outcome": "Passed",
      "failure": "e1",
      "sent": []
     },
     "expected": "Proved"
    },
    {
     "args": {
      "outcome": "Failed",
      "failure": "e1",
      "sent": []
     },
     "expected": "SendBack"
    },
    {
     "args": {
      "outcome": "Failed",
      "failure": "e1",
      "sent": [
       "e2"
      ]
     },
     "expected": "SendBack"
    },
    {
     "args": {
      "outcome": "Failed",
      "failure": "e1",
      "sent": [
       "e2",
       "e1"
      ]
     },
     "expected": "NoProgress"
    },
    {
     "args": {
      "outcome": "Vacuous",
      "failure": "e3",
      "sent": [
       "e3"
      ]
     },
     "expected": "NoProgress"
    },
    {
     "args": {
      "outcome": "Vacuous",
      "failure": "e3",
      "sent": []
     },
     "expected": "SendBack"
    },
    {
     "args": {
      "outcome": "NotStarted",
      "failure": "e1",
      "sent": [
       "e1"
      ]
     },
     "expected": "Operator"
    },
    {
     "args": {
      "outcome": "TimedOut",
      "failure": "e1",
      "sent": []
     },
     "expected": "Operator"
    },
    {
     "args": {
      "outcome": "Cancelled",
      "failure": "e1",
      "sent": []
     },
     "expected": "Operator"
    }
   ]
  }
 ]
}