 "tasks": [
  {
   "id": "t01-clamp",
   "prose": "Limit a value to a range. Given `value`, `low` and `high`, where callers guarantee `low <= high`, return `low` when `value` is below `low`, `high` when it is above `high`, and `value` itself otherwise.",
   "params": [
    "value",
    "low",
    "high"
   ],
   "types": [
    "Int",
    "Int",
    "Int"
   ],
   "result": "Int",
   "accord": {
    "name": "clamp",
    "decls": []
   },
   "ts": {
    "name": "clamp",
    "params": [
     "value",
     "low",
     "high"
    ],
    "decls": []
   },
   "examples": [
    {
     "args": {
      "value": 5,
      "low": 0,
      "high": 10
     },
     "expected": 5
    },
    {
     "args": {
      "value": -3,
      "low": 0,
      "high": 10
     },
     "expected": 0
    },
    {
     "args": {
      "value": 12,
      "low": 0,
      "high": 10
     },
     "expected": 10
    },
    {
     "args": {
      "value": 0,
      "low": 0,
      "high": 10
     },
     "expected": 0
    },
    {
     "args": {
      "value": 10,
      "low": 0,
      "high": 10
     },
     "expected": 10
    },
    {
     "args": {
      "value": 7,
      "low": 7,
      "high": 7
     },
     "expected": 7
    },
    {
     "args": {
      "value": -20,
      "low": -10,
      "high": -5
     },
     "expected": -10
    },
    {
     "args": {
      "value": -1,
      "low": -10,
      "high": -5
     },
     "expected": -5
    }
   ]
  },
