   "id": "t04-within-budget",
   "prose": "A measurement is retried once, and it keeps to its budget when at least one of the two attempts is within the limit. Given the two measurements `first` and `second` and the `limit`, all of which callers guarantee are zero or more, return whether either measurement is at most the limit.",
   "params": [
    "first",
    "second",
    "limit"
   ],
   "types": [
    "Int",
    "Int",
    "Int"
   ],
   "result": "Bool",
   "accord": {
    "name": "within_budget_after_retry",
    "decls": []
   },
   "ts": {
    "name": "withinBudgetAfterRetry",
    "params": [
     "first",
     "second",
     "limit"
    ],
    "decls": []
   },
   "examples": [
    {
     "args": {
      "first": 5,
      "second": 9,
      "limit": 6
     },
     "expected": true
    },
    {
     "args": {
      "first": 9,
      "second": 5,
      "limit": 6
     },
     "expected": true
    },
    {
     "args": {
      "first": 9,
      "second": 8,
      "limit": 6
     },
     "expected": false
    },
    {
     "args": {
      "first": 6,
      "second": 7,
      "limit": 6
     },
     "expected": true
    },
    {
     "args": {
      "first": 0,
      "second": 0,
      "limit": 0
     },
     "expected": true
    },
    {
     "args": {
      "first": 1,
      "second": 1,
      "limit": 0
     },
     "expected": false
    }
   ]
  },
