// expect: refuted, proved, refuted, proved, refuted, proved, proved, refuted, proved, proved, proved, proved, proved, proved, proved, passed, failed
// Planted fault: the `timed_out` row is missing.
/// How one proof of a file ended.
pub enum ProofOutcome { Passed, Failed, Vacuous, TimedOut, Cancelled, NotStarted }

pub fn proof_outcome(
    cancelled: Bool,
    timed_out: Bool,
    started: Bool,
    regenerated: Bool,
    check_exit: i32,
    verified: i64,
) -> ProofOutcome
    intent "A proof passes only if nothing stopped it and something was verified."
    requires verified >= 0
    ensures result == Passed implies not cancelled and not timed_out and started and regenerated and check_exit == 0 and verified > 0
    ensures not cancelled and not timed_out and started and regenerated and check_exit == 0 and verified > 0 implies result == Passed
    ensures result == Vacuous implies not cancelled and not timed_out and started and regenerated and check_exit == 0 and verified == 0
    ensures not cancelled and not timed_out and started and regenerated and check_exit == 0 and verified == 0 implies result == Vacuous
    ensures result == NotStarted implies not cancelled and not timed_out and not started
    ensures not cancelled and not timed_out and not started implies result == NotStarted
    ensures cancelled implies result == Cancelled
    ensures not cancelled and timed_out implies result == TimedOut
    ensures result == Failed implies started and (not regenerated or check_exit != 0)
decide {
    | cancelled                          => Cancelled
    | not started                        => NotStarted
    | not regenerated or check_exit != 0 => Failed
    | verified > 0                       => Passed
    | otherwise                          => Vacuous
}

example proof_outcome(
    cancelled: false, timed_out: false, started: true,
    regenerated: true, check_exit: 0, verified: 3,
) == Passed

example proof_outcome(
    cancelled: false, timed_out: true, started: true,
    regenerated: true, check_exit: 0, verified: 3,
) == TimedOut
