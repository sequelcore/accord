// expect: proved, proved, proved, proved, proved, passed, passed
// A caller sees a call's result only through the callee's contract: `twice`
// is proved from `successor`'s `ensures`, and each call meets `successor`'s
// `requires` where it runs.
fn successor(n: i32) -> i32
    requires n < 100
    ensures result == n + 1
{
    n + 1
}

fn twice(n: i32) -> i32
    requires n >= 0 and n < 50
    ensures result == n + 2
{
    successor(successor(n))
}

example successor(n: 4) == 5
example twice(n: 3) == 5
