// expect: proved, proved, proved, passed, passed
// A variant may carry fields. A `match` binds one field by position and
// several by label, so a label decides which field a name is.
enum Bound { Unbounded, Below(limit: i64), Between(low: i64, high: i64) }

fn admits(bound: Bound, n: i64) -> Bool
    ensures bound == Unbounded implies result
    ensures bound == Below(limit: 0) implies result == (n < 0)
    ensures bound == Between(low: 1, high: 3) implies result == (n >= 1 and n <= 3)
{
    match bound {
        | Unbounded                => true
        | Below(limit)             => n < limit
        | Between(low: a, high: b) => a <= n and n <= b
    }
}

example admits(bound: Below(limit: 5), n: 4) == true
example admits(bound: Between(high: 3, low: 1), n: 4) == false
