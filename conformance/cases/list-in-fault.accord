// expect: refuted, failed, failed, failed
// open: determined
fn already_sent(failure: Text, sent: List<Text>) -> Bool
    ensures result == (failure in sent)
{
    not failure in sent
}

example already_sent(failure: "timeout", sent: ["exit 1", "timeout"]) == true
example already_sent(failure: "timeout", sent: ["exit 1"]) == false
example already_sent(failure: "timeout", sent: []) == false
