// expect: proved, passed, passed
// An arm's arithmetic runs only for its variant, and its obligation holds
// under that arm alone.
enum Step { Stay, Add(amount: i32) }

fn apply(step: Step, n: i32) -> i32
    requires n >= 0 and n <= 100
    requires match step { | Stay => true | Add(a) => a >= 0 and a <= 100 }
{
    match step {
        | Stay   => n
        | Add(a) => n + a
    }
}

example apply(step: Add(amount: 3), n: 4) == 7
example apply(step: Stay, n: 4) == 4
