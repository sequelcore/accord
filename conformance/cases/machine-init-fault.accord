// expect: proved, refuted, proved, proved, proved, proved
// `broken` starts past the bound the invariant sets, so the run that is only
// `broken()` breaks it.
enum Light { Off, On }

machine Switch {
    state {
        light: Light,
        presses: i32,
    }

    init start() {
        next { light: Off, presses: 0 }
    }

    init broken() {
        next { light: Off, presses: 101 }
    }

    event press()
        requires presses < 100
    {
        if light == Off {
            next { light: On, presses: presses + 1 }
        } else {
            next { light: Off, presses: presses + 1 }
        }
    }

    invariant pressed: presses >= 0 and presses <= 100
}
