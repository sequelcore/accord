// expect: proved, proved, proved, refuted
// Without its `requires`, the third increment overflows `i32`.
machine Counter {
    state {
        count: i32,
    }

    init near_top() {
        next { count: 2147483645 }
    }

    event increment()
    {
        next { count: count + 1 }
    }

    invariant non_negative: count >= 0
}
