// expect: proved, proved, proved, proved, proved, passed, passed
// A function may call itself when its `decreases` measure, an integer, is
// smaller and non-negative at each call. The call is proved through the
// function's own contract, as any call is.
fn steps(n: i32) -> i32
    requires n >= 0
    decreases n
    ensures result == n
{
    if n == 0 { 0 } else { steps(n - 1) + 1 }
}

example steps(n: 0) == 0
example steps(n: 5) == 5
