// expect: proved, proved, proved, refuted, proved, passed, passed
// Smaller isn't enough: the measure must be non-negative at each call. Here
// it is -1 at the call `steps(1)` makes.
fn steps(n: i32) -> i32
    requires n >= 0
    decreases n - 1
    ensures result == n
{
    if n == 0 { 0 } else { steps(n - 1) + 1 }
}

example steps(n: 0) == 0
example steps(n: 5) == 5
