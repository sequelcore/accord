// expect: proved, proved, weak_callee, proved
// `successor`'s contract allows any larger result, and its body gives n + 1.
// `plus_one` holds when run, but can't be proved from the contract alone: the
// solvers' counterexample fails only with a result the contract allows and
// the body never gives.
fn successor(n: i32) -> i32
    requires n < 100
    ensures result > n
{
    n + 1
}

fn plus_one(n: i32) -> i32
    requires n < 100
    ensures result == n + 1
{
    successor(n)
}
