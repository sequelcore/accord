// expect: refuted, proved, proved, refuted, proved, proved, proved, proved, proved, proved, proved, proved, passed, failed, passed, passed, passed
// Planted fault: a passed proof reads as a rejected mutant.
/// How one proof of a file ended.
enum ProofOutcome { Passed, Failed, Vacuous, TimedOut, Cancelled, NotStarted }

/// What one mutant's proof says about the contract it was proved under.
enum MutantFinding { Rejected, Survived, Inconclusive }

fn mutant_finding(outcome: ProofOutcome) -> MutantFinding
    ensures result == Rejected implies outcome == Failed
    ensures outcome == Failed implies result == Rejected
    ensures result == Survived implies outcome == Passed
    ensures outcome == Passed implies result == Survived
    ensures result == Inconclusive implies outcome != Failed and outcome != Passed
    ensures outcome != Failed and outcome != Passed implies result == Inconclusive
decide {
    | outcome == Failed => Rejected
    | outcome == Passed => Rejected
    | otherwise         => Inconclusive
}

/// Whether a surviving mutant is dropped as equivalent: only a proof that
/// passed drops it.
fn equivalent_mutant(outcome: ProofOutcome) -> Bool
    ensures result implies outcome == Passed
    ensures outcome == Passed implies result
{
    outcome == Passed
}

example mutant_finding(Failed) == Rejected
example mutant_finding(Passed) == Survived
example mutant_finding(TimedOut) == Inconclusive
example equivalent_mutant(Passed) == true
example equivalent_mutant(Vacuous) == false
