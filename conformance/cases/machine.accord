// expect: proved, proved, proved, proved, proved, passed
// A switch that counts its presses. The invariant holds of the state `start`
// gives and after each `press`, `press` is allowed in the state `start`
// gives, and each addition stays within `i32`.
enum Light { Off, On }

machine Switch {
    state {
        light: Light,
        presses: i32,
    }

    init start() {
        next { light: Off, presses: 0 }
    }

    event press()
        requires presses < 100
    {
        if light == Off {
            next { light: On, presses: presses + 1 }
        } else {
            next { light: Off, presses: presses + 1 }
        }
    }

    invariant pressed: presses >= 0 and presses <= 100
}

example Switch
    start()
    press()
    gives light == On and presses == 1
