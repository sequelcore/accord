// expect: refuted, proved, proved, proved, proved, proved, passed, passed, passed, passed, passed, passed, passed, passed, passed
// Copyright 2019 Softonic International S.A.
// SPDX-License-Identifier: Apache-2.0
// Port of isRetryableError, isSafeRequestError and isIdempotentRequestError,
// modified from axios-retry 4.5.0 at a748627fdc5e22e659055b6cfb44e35ad5801bf4:
// https://github.com/softonic/axios-retry/blob/a748627fdc5e22e659055b6cfb44e35ad5801bf4/src/index.ts
// The project is archived. Accord has no records, so an AxiosError arrives as
// its fields: `code` ("" when absent), whether a response came, its status
// (0 when none) and the request's method ("" when absent). The request
// predicates call the retry rule; their contracts restate it, since a
// specification can't call a function yet. Licensed under Apache-2.0; see
// LICENSE-APACHE at the repository root.

/// A failed request may be retried: it wasn't aborted, and no response came
/// or the server answered 429 or 5xx.
pub fn retryable_error(code: Text, has_response: Bool, status: i32) -> Bool
    intent "Retry unless the request was aborted, when no response came, or the response was a 429 or a server error."
    ensures result implies code != "ECONNABORTED" and (not has_response or status == 429 or status >= 500 and status <= 599)
    ensures code != "ECONNABORTED" and (not has_response or status == 429 or status >= 500 and status <= 599) implies result
{
    code != "ECONNABORTED" and (not has_response or status == 429 or status >= 500 and status <= 600)
}

/// A retryable failure of a safe request: GET, HEAD or OPTIONS.
pub fn safe_request_error(code: Text, has_response: Bool, status: i32, method: Text) -> Bool
    intent "Retry a safe request when its failure is retryable."
    ensures result implies method in ["get", "head", "options"] and code != "ECONNABORTED" and (not has_response or status == 429 or status >= 500 and status <= 599)
    ensures method in ["get", "head", "options"] and code != "ECONNABORTED" and (not has_response or status == 429 or status >= 500 and status <= 599) implies result
{
    method in ["get", "head", "options"] and retryable_error(code: code, has_response: has_response, status: status)
}

/// A retryable failure of an idempotent request: a safe one, PUT or DELETE.
pub fn idempotent_request_error(code: Text, has_response: Bool, status: i32, method: Text) -> Bool
    intent "Retry an idempotent request when its failure is retryable."
    ensures result implies method in ["get", "head", "options", "put", "delete"] and code != "ECONNABORTED" and (not has_response or status == 429 or status >= 500 and status <= 599)
    ensures method in ["get", "head", "options", "put", "delete"] and code != "ECONNABORTED" and (not has_response or status == 429 or status >= 500 and status <= 599) implies result
{
    method in ["get", "head", "options", "put", "delete"] and retryable_error(code: code, has_response: has_response, status: status)
}

example retryable_error(code: "ECONNRESET", has_response: false, status: 0) == true
example retryable_error(code: "ECONNABORTED", has_response: false, status: 0) == false
example retryable_error(code: "", has_response: true, status: 503) == true
example retryable_error(code: "", has_response: true, status: 429) == true
example retryable_error(code: "", has_response: true, status: 404) == false
example safe_request_error(code: "", has_response: true, status: 500, method: "get") == true
example safe_request_error(code: "", has_response: true, status: 500, method: "post") == false
example idempotent_request_error(code: "", has_response: true, status: 500, method: "put") == true
example idempotent_request_error(code: "", has_response: true, status: 500, method: "") == false
